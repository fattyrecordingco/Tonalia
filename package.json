{
  "name": "tonalia",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Nondestructive spectral audio editing by Fatty Recording Co",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "engine:build": "wasm-pack build crates/tonalia-wasm --target web --out-dir ../../apps/web/src/wasm --release",
    "typecheck": "tsc --noEmit",
    "build": "npm run notices && npm run engine:build && npm run typecheck && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts --host 127.0.0.1",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test:core": "cargo test -p tonalia-core",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test:audio && npm run test:core && npm run test:e2e",
    "format": "prettier --write apps/web/src apps/web/public/audio-processor.js tests playwright.config.ts apps/web/vite.config.ts",
    "format:check": "prettier --check apps/web/src apps/web/public/audio-processor.js tests playwright.config.ts apps/web/vite.config.ts",
    "test:native": "node tests/native/smoke.mjs",
    "notices": "node scripts/notices.mjs",
    "build:website": "node scripts/build-website.mjs",
    "preview:website": "node scripts/serve-website.mjs",
    "test:website": "playwright test --config playwright.website.config.ts",
    "screenshots:guide": "node scripts/capture-guide.mjs",
    "test:audio": "node tests/audio/worklet.mjs",
    "test:brush:native": "node tests/native/brush-playback.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "wasm-pack": "0.15.0"
  }
}
