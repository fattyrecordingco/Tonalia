{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "isolatedModules": true, "esModuleInterop": true,
    "types": ["vite/client", "node"]
  },
  "include": ["apps/web/src", "apps/web/vite.config.ts", "tests", "playwright.config.ts"]
}
